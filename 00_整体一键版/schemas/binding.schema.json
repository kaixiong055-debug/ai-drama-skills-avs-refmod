{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-drama:v5:binding",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "5.0",
        "5.1"
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "patternProperties": {
          "^P[1-9]$": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "asset_id",
              "file",
              "sha256"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "asset_files": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "lineage",
    "units",
    "asset_files"
  ],
  "additionalProperties": true
}
